# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Telegram (SOS message + call, free; used before Twilio when set)
#   TELEGRAM_BOT_TOKEN: from @BotFather (/newbot)
#   TELEGRAM_CHAT_ID: the contact presses Start on the bot, then: python scripts/telegram_check.py --chat-id
#   TELEGRAM_CALL_USER: the contact's Telegram @username; the contact sends /start to @CallMeBot_txtbot once
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CALL_USER=

# Twilio (SOS call + SMS; a trial account refuses our text)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Contacts (phone numbers stay only in .env)
EMERGENCY_NUMBER=
SAFE_CONTACT_NUMBER=

# DriveMate Contact page
CONTACT_TOKEN=

# Phone bridge (KDE Connect)
KDECONNECT_DEVICE_ID=
CORE_URL=http://localhost:8000
